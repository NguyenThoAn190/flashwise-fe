# Flashwise FE — production env (Vercel)
# Next.js load file này khi `next build` (NODE_ENV=production).
# Lưu ý: NEXT_PUBLIC_* bị bake vào bundle lúc build, nên trên Vercel
# vẫn phải set lại 2 biến dưới trong Dashboard (Settings → Environment Variables).

# Public Gateway cho browser calls
NEXT_PUBLIC_API_URL=https://api.playgrid.vn/api/v1

# Vercel không có docker DNS nên rewrite server-side (/api/v1/:path*)
# cũng phải trỏ ra public gateway, không dùng http://api-gateway:8080
GATEWAY_INTERNAL_URL=https://api.playgrid.vn/api/v1

# Google Identity Services — Web OAuth Client ID (giống local).
# Nhớ vào Google Cloud Console > Credentials > Authorized JS origins
# thêm domain Vercel production (vd https://flashwise.vercel.app).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=802848040471-2o7jiqnlkbt16f8qg6n4pkin6kj7lfi5.apps.googleusercontent.com
