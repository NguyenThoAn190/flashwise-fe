# PlayGrid API Gateway Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google Identity Services (GIS) - Web OAuth Client ID for Google Login button.
# Get from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (type: Web).
# Authorized JS origins must include http://localhost:3000 (dev) and production domain.
# This value MUST match backend EXTERNAL_GOOGLE_CLIENT_ID (account-service) for id_token aud verification.
# If empty/missing, GoogleLoginButton shows googleNoClient message and falls back to email/password.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx

# SEO / Analytics — điền khi có domain production
# Canonical site URL dùng cho metadataBase, canonical, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://flashwise.app
# Google Search Console verify token (meta name=google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=
# GA4 Measurement ID dạng G-XXXXXXXXXX (ưu tiên chạy qua GTM nếu có cả hai)
NEXT_PUBLIC_GA_ID=
# Google Tag Manager Container ID dạng GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=